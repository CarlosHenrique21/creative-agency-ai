OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...   # para os agentes de texto (Gemini 2.0 Flash)

# API settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Output directories
OUTPUT_DIR=./output/flyers

# Agent settings
MAX_REVISION_CYCLES=3
DEFAULT_BRAND_STYLE=modern

# Image generation
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=high

# RAG
CHROMA_BRAND_DIR=./chroma_db/brands
CHROMA_VISUAL_DIR=./chroma_db/visuals
